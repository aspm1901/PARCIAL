@model IEnumerable<PlataformaIncidencias.Models.Incidencia>
@{
    ViewData["Title"] = "Gestión de Incidencias";
    var origenDatos = ViewData["OrigenDatos"] as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1>Incidencias abiertas con consulta rápida</h1>
            <p class="text-muted mb-0">
                Listado optimizado con caché distribuido Redis (expiración 60 segundos).
                @if (!string.IsNullOrEmpty(origenDatos))
                {
                    <span class="badge bg-light text-dark border ms-2">
                        <i class="bi bi-hdd-network me-1"></i> @origenDatos
                    </span>
                }
            </p>
        </div>
        <div>
            <span class="badge bg-primary px-3 py-2 fs-6">
                Total abiertas: @Model.Count()
            </span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm" role="alert">
            <i class="bi bi-info-circle me-2"></i> No se registran incidencias abiertas en este momento.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0" style="border-radius: 10px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #0f172a; color: #ffffff;">
                        <tr>
                            <th class="py-3 px-3">ID</th>
                            <th class="py-3">Estación</th>
                            <th class="py-3">Descripción</th>
                            <th class="py-3">Prioridad</th>
                            <th class="py-3">Estado</th>
                            <th class="py-3">Fecha de Registro</th>
                            <th class="py-3 text-end px-3">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-3 fw-bold text-secondary">#@item.Id</td>
                                <td class="fw-semibold text-dark">@item.Estacion</td>
                                <td>@item.Descripcion</td>
                                <td>
                                    @if (item.Prioridad == "Alta")
                                    {
                                        <span class="badge bg-danger">Alta</span>
                                    }
                                    else if (item.Prioridad == "Media")
                                    {
                                        <span class="badge bg-warning text-dark">Media</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Baja</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success">@item.Estado</span>
                                </td>
                                <td class="text-muted small">@item.FechaRegistro.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end px-3">
                                    <form asp-action="Cerrar" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que desea cerrar esta incidencia?');">
                                            Cerrar Incidencia
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
